# Required. Choose an unpredictable code of 10 or more characters.
ROBOT_ACCESS_CODE=replace-me-with-a-long-private-code-123
PORT=3000

# Leave BOTH fields empty to test the free local camera preview.
# For live AI, use Singapore Model Studio PAY-AS-YOU-GO credentials.
# Do NOT use an Alibaba Token Plan/Coding Plan key for a standalone app.
ALIBABA_API_KEY=
ALIBABA_WORKSPACE_ID=

# Dynamic visual planning reuses the same Singapore key and workspace.
# Enable this model in your Model Studio account. Each plan is an extra paid call.
# This is a CHAT model that returns JSON drawing instructions, not an image model.
# Image models belong only in ALIBABA_IMAGE_MODEL below.
ALIBABA_VISUAL_MODEL=qwen-plus

# Optional: a compatible synchronous multimodal image-generation model enabled
# in your Singapore workspace. Leave blank to disable paid artwork generation.
# Parent setup also requires explicit picture consent for each session.
# Recommended target for Mini: qwen-image-3.0 (one 1024x1024 image).
# Optional quality comparison: qwen-image-3.0-pro. Manual fallback: qwen-image-2.0.
# See docs/image-model-research.md for sources and access limitations.
# Use parent settings -> Check model IDs, or your signed-in Singapore catalog.
# A catalog listing does not prove generation entitlement. Do not guess model IDs.
# Changes require restarting npm start and refreshing Safari. git pull does not
# update your existing private .env; replace the blank line there yourself.
ALIBABA_IMAGE_MODEL=
# Native Singapore image endpoint, independent of the realtime workspace route.
# Use workspace only if your account requires the workspace-specific image route.
ALIBABA_IMAGE_ENDPOINT=singapore

# Legacy cloud observation API only; current UI uses local camera landmarks.
# No extra vision-chat model is needed for local smiles/head movement.
ALIBABA_AWARENESS_MODEL=qwen-vl-plus
