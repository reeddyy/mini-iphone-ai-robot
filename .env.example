# Required. Choose an unpredictable code of 10 or more characters.
ROBOT_ACCESS_CODE=replace-me-with-a-long-private-code-123
PORT=3000

# Leave BOTH fields empty to test the free local camera preview.
# For live AI, use Singapore Model Studio PAY-AS-YOU-GO credentials.
# Do NOT use an Alibaba Token Plan/Coding Plan key for a standalone app.
ALIBABA_API_KEY=
ALIBABA_WORKSPACE_ID=

# Visual planner: a CHAT model for story/picture prompts and game choices.
# Reuses the Singapore key and workspace above; each plan is an extra paid call.
# This model does not generate the actual image.
ALIBABA_VISUAL_MODEL=qwen-plus

# Image generator: creates actual pictures, one 1024x1024 image per request.
# Recommended target, subject to access in your Singapore workspace.
# Pictures default on when configured; every paid session needs parent confirmation,
# including extra image charges. Leave this value blank to disable generation.
ALIBABA_IMAGE_MODEL=qwen-image-3.0

# Native Singapore image endpoint, independent of the realtime workspace route.
# Use workspace only if your account requires the workspace-specific image route.
ALIBABA_IMAGE_ENDPOINT=singapore

# Check image model IDs: parent settings -> Troubleshooting -> Connection and
# picture setup -> Check image model setup, or your signed-in Singapore catalog.
# A listing does not prove generation access. See docs/image-model-research.md.
# After editing your private .env, restart Mini and refresh Safari.
# git pull updates this template, not your existing private .env.
# Local camera reactions need no separate cloud model setting.
